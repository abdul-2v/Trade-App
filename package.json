{
  "name": "trade-app",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "dev:auto": "bash scripts/dev-auto.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.cjs",
    "test:logic": "node scripts/test-marketplace-logic.cjs && npm run test:scheduling && npm run test:messaging-postcodes && npm run test:launch-security",
    "check:ux": "node scripts/check-ux.cjs",
    "test:account": "node scripts/test-account-registration.cjs",
    "dev:auto:tunnel": "TRADARR_EXPO_CONNECTION=tunnel bash scripts/dev-auto.sh",
    "test:scheduling": "node scripts/test-scheduling-journeys.cjs",
    "test:messaging-postcodes": "node scripts/test-messaging-postcodes.cjs",
    "test:launch-security": "node scripts/test-launch-security.cjs"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-updates": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-symbols": "~58.0.4",
    "expo-location": "~58.0.18",
    "@supabase/supabase-js": "2.118.0",
    "react-native-url-polyfill": "2.0.0",
    "expo-sqlite": "~58.0.14",
    "react-native-webview": "14.0.1",
    "expo-image-picker": "~58.0.10",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "lucide-react-native": "^1.72.0",
    "react-native-svg": "15.16.0",
    "expo-print": "~58.0.2",
    "expo-sharing": "~58.0.23",
    "expo-notifications": "~58.1.9",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "react-native-purchases": "9.6.6",
    "expo-dev-client": "~58.0.21"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
