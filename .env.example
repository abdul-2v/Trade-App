EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Public RevenueCat SDK keys (safe to embed in the app; NOT secret API keys)
# Real purchases only run in development/production builds after store setup.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Tradarr website and app accounts MUST share the existing Supabase Auth project:
# EXPO_PUBLIC_SUPABASE_URL=https://sjwedfdwqxfrnpruiqnq.supabase.co
# Set the PUBLISHABLE key from this same Supabase project; do not reuse keys
# from a different Supabase project, and never expose service-role keys.
# Website equivalents: NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in Vercel.
